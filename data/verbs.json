          "pattern": "inf = past = pp",
          "verbs": [
            {"inf": "bet", "past": "bet", "pp": "bet", "cs": "sázet, vsadit (se, si)", "emoji": "🎲"},
            {"inf": "cost", "past": "cost", "pp": "cost", "cs": "stát, mít cenu", "emoji": "🏷️"},
            {"inf": "cut", "past": "cut", "pp": "cut", "cs": "řezat, sekat, krájet", "emoji": "✂️"},
